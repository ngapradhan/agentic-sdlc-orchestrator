{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "dag",
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "const": "S0 bootstrap only"
    },
    "nodes": {
      "const": [
        "intake",
        "plan",
        "summary"
      ]
    },
    "edges": {
      "const": [
        [
          "intake",
          "plan"
        ],
        [
          "plan",
          "summary"
        ]
      ]
    }
  },
  "required": [
    "version",
    "scope",
    "nodes",
    "edges"
  ]
}
